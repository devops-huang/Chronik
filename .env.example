# 辰箓 · Chronik 运行环境变量示例
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会进仓库）

# ===== 大模型（阿里云百炼 / OpenAI 兼容接口）=====
LLM_BASE_URL=https://your-endpoint/v1
LLM_API_KEY=your-api-key
LLM_MODEL=qwen3.7-plus

# ===== PostgreSQL =====
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=chenlu
PGPASSWORD=your-db-password
PGDATABASE=chenlu

# ===== 服务 =====
PORT=8787
